# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHANNEL_ID=your_channel_id_here (optional, for broadcasting)

# Telegram Broadcasting (optional)
# REMOVED — no longer used: BROADCAST_NEWS_INTERVAL_MINUTES
# REMOVED — no longer used: BROADCAST_SELF_AD_INTERVAL_HOURS
# REMOVED — no longer used: BROADCAST_MIN_NEWS_RELEVANCE
# REMOVED — no longer used: BROADCAST_MARKET_UPDATE_INTERVAL_MINUTES
# REMOVED — no longer used: BROADCAST_TOP_TOKEN_COUNT
# REMOVED — no longer used: BROADCAST_TOP_TOKEN_MIN_LIQUIDITY_USD
# REMOVED — no longer used: BROADCAST_NEWS_MAX_AGE_HOURS
# REMOVED — no longer used: BROADCAST_LAUNCH_UPDATE_INTERVAL_MINUTES
# REMOVED — no longer used: BROADCAST_LAUNCH_MAX_AGE_MINUTES
# REMOVED — no longer used: BROADCAST_LAUNCH_MIN_LIQUIDITY_USD
# REMOVED — no longer used: BROADCAST_LAUNCH_SCAN_LIMIT
# REMOVED — no longer used: BROADCAST_MAX_TOKEN_NEWS_KEYWORDS
# REMOVED — no longer used: BROADCAST_EXTRA_NEWS_SOURCES
# REMOVED — no longer used: BROADCAST_SOCIAL_NEWS_SOURCES
BROADCAST_MIN_LIQUIDITY_USD=30000  # Minimum liquidity for whale trade signals (also used by copy trader)

# Admin Configuration
# Comma-separated list of Telegram user IDs with admin access
ADMIN_IDS=123456789,987654321

# Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WSS_URL=wss://api.mainnet-beta.solana.com

# Database
DB_PATH=trade_bot.db  # Legacy SQLite (fallback if DATABASE_URL not set)
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require  # Neon PostgreSQL

# Server
PORT=10000
WEB_PORT=5000
RENDER_EXTERNAL_URL=your_render_url_here

# Security & Encryption
ENCRYPTION_MASTER_PASSWORD=change_this_to_secure_password_32_chars_min

# Logging
LOG_LEVEL=INFO

# Copy Trading
COPY_TRADE_CHECK_INTERVAL=10
WALLET_MONITOR_INTERVAL=5
SLIPPAGE_TOLERANCE=2.0
MIN_TRADE_AMOUNT=0.01

# Whale Qualification
WHALE_MIN_WIN_RATE=0.60
WHALE_MIN_TRADES=20
WHALE_MIN_AVG_PROFIT=-10.0
WHALE_STALE_DAYS=14
WHALE_MAX_CONSECUTIVE_LOSSES=3

# Signal Scaling (1 whale = 0.5x, 2 whales = 1.0x, 3+ whales = 1.5x)
COPY_SIGNAL_SCALE_1_WHALE=0.5
COPY_SIGNAL_SCALE_2_WHALE=1.0
COPY_SIGNAL_SCALE_3_WHALE=1.5

# Exit / Trailing Stop
COPY_DEFAULT_TRAILING_STOP=0.10
SMART_TRAILING_STOP_PCT=0.10

# Daily Loss Limit
ENABLE_DAILY_LOSS_LIMIT=true
DAILY_LOSS_LIMIT_PCT=5.0

# Risk Management
DEFAULT_STOPLOSS_PERCENT=5.0
DEFAULT_TAKEPROFIT_PERCENT=10.0
MAX_POSITION_SIZE_PERCENT=10.0

# MEV Protection
JITO_TIP_AMOUNT=0.001
USE_PRIVATE_POOLS=true

# Hardware Wallet
PHANTOM_URL=https://phantom.app/
LEDGER_DERIVATION_PATH=m/44'/501'/0'/0'
